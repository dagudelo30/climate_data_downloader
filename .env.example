# Copy to .env (never commit .env). Every variable is optional except for the sources you use.

# Root of the Medallion data lake (bronze/, silver/, gold/, state/)
CLIMATE_DATA_ROOT=data

# --- AgERA5 / Copernicus CDS -----------------------------------------------------------
# Personal access token from https://cds.climate.copernicus.eu/profile
# (accept the licence of "sis-agrometeorological-indicators" once in the web portal).
# If unset, ~/.cdsapirc is used.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Google Earth Engine ---------------------------------------------------------------
# Cloud project registered for Earth Engine. Locally, run `earthengine authenticate` once;
# in CI, point GEE_SERVICE_ACCOUNT_KEY to a service-account JSON key.
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_KEY=

# --- MSWEP (Google Drive, access granted by GloH2O) ------------------------------------
MSWEP_SERVICE_ACCOUNT_KEY=
MSWEP_OAUTH_CLIENT=data/auxiliary/tokens/client.json
MSWEP_TOKEN=data/auxiliary/tokens/mswep_token.json
